CREATE TABLE MemoEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL,
    pinned INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM MemoEntity ORDER BY pinned DESC, updatedAt DESC;

selectById:
SELECT * FROM MemoEntity WHERE id = ?;

insert:
INSERT INTO MemoEntity(title, content, color, pinned, updatedAt)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE MemoEntity
SET title = ?, content = ?, color = ?, pinned = ?, updatedAt = ?
WHERE id = ?;

deleteById:
DELETE FROM MemoEntity WHERE id = ?;

lastInsertedId:
SELECT last_insert_rowid();
